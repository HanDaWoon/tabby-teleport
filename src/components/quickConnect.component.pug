.modal-header
  h4.modal-title Quick Connect
  .ms-auto.d-flex.align-items-center
    button.btn.btn-sm.btn-outline-secondary.me-2(
      (click)="refresh()",
      [disabled]="loading",
      title="Refresh node list"
    )
      i.fas.fa-sync-alt([class.fa-spin]="loading")
    button.btn-close((click)="close()")

.modal-body
  .alert.alert-warning.d-flex.align-items-center.mb-3(*ngIf="isStaleSession")
    i.fas.fa-exclamation-triangle.me-2
    small Session expired - selecting a node will trigger re-login (SSO/MFA prompt may appear) and then connect.

  .input-group.mb-3
    span.input-group-text
      i.fas.fa-search
    input.form-control(
      type="text",
      [(ngModel)]="filter",
      (ngModelChange)="onFilterInput()",
      placeholder="Search by hostname, label, or address...",
      autofocus,
      (keydown.enter)="connectFirst()"
    )

  .node-area
    .d-flex.align-items-center.justify-content-center.h-100(*ngIf="loading")
      i.fas.fa-spinner.fa-spin.me-2
      | Loading nodes...

    .text-muted.d-flex.align-items-center.justify-content-center.h-100(*ngIf="!loading && filteredNodes.length === 0")
      | No nodes found.

    .list-group(#nodeList, *ngIf="!loading && filteredNodes.length > 0")
      button.list-group-item.list-group-item-action(
        *ngFor="let nv of filteredNodes; let i = index",
        [class.active]="i === selectedIndex",
        (click)="connect(nv)",
        (mouseenter)="selectedIndex = i"
      )
        .d-flex.justify-content-between.align-items-center
          div
            strong {{ nv.node.spec.hostname }}
            small.text-muted.ms-2 {{ nv.node.spec.addr }}
            small.text-muted.ms-2(*ngIf="nv.node.cluster") ({{ nv.node.cluster }})
          div
            span.badge.bg-secondary.me-1(
              *ngFor="let tag of nv.labels"
            ) {{ tag }}
