h3.mb-4 Teleport Settings

h5.mb-3 General

.form-group.mb-3
  label.form-label tsh Path
  input.form-control(
    type="text",
    [(ngModel)]="config.store.teleport.tshPath",
    (ngModelChange)="config.save()",
    placeholder="tsh"
  )
  small.form-text.text-muted Path to the tsh binary. Leave as "tsh" if it's in your PATH.

.form-group.mb-3
  label.form-label Default SSH User
  input.form-control(
    type="text",
    [(ngModel)]="config.store.teleport.defaultUser",
    (ngModelChange)="config.save()",
    placeholder="root"
  )
  small.form-text.text-muted Default SSH username for Teleport connections.

h5.mt-4.mb-3 Login Settings

.form-group.mb-3
  label.form-label Proxy Address
  input.form-control(
    type="text",
    [(ngModel)]="config.store.teleport.proxy",
    (ngModelChange)="config.save()",
    placeholder="teleport.example.com:443"
  )
  small.form-text.text-muted Teleport proxy address (--proxy).

.form-group.mb-3
  label.form-label Login User
  input.form-control(
    type="text",
    [(ngModel)]="config.store.teleport.loginUser",
    (ngModelChange)="config.save()",
    placeholder=""
  )
  small.form-text.text-muted Teleport login username (--user). Leave empty to use the default.

.form-group.mb-3
  label.form-label Auth Type
  select.form-control(
    [(ngModel)]="config.store.teleport.authType",
    (ngModelChange)="config.save()"
  )
    option(value="") Default
    option(value="local") Local
    option(value="github") GitHub
    option(value="saml") SAML
    option(value="oidc") OIDC
  small.form-text.text-muted Authentication type (--auth).

.form-group.mb-3
  label.form-label Cluster
  input.form-control(
    type="text",
    [(ngModel)]="config.store.teleport.cluster",
    (ngModelChange)="config.save()",
    placeholder=""
  )
  small.form-text.text-muted Teleport cluster name to login to. Leave empty for the default cluster.

h5.mt-4.mb-3 Environment Variables
small.form-text.text-muted.mb-3.d-block Environment variables to set when running tsh commands (e.g. TELEPORT_HOME, TSH_LOG).

.mb-2(*ngFor="let entry of envEntries")
  .input-group
    input.form-control(type="text", [value]="entry[0]", disabled)
    input.form-control(type="text", [value]="entry[1]", disabled)
    button.btn.btn-outline-danger((click)="removeEnvVar(entry[0])")
      i.fas.fa-trash

.input-group.mb-3
  input.form-control(
    type="text",
    [(ngModel)]="newEnvKey",
    placeholder="KEY"
  )
  input.form-control(
    type="text",
    [(ngModel)]="newEnvValue",
    placeholder="value"
  )
  button.btn.btn-outline-primary((click)="addEnvVar()")
    i.fas.fa-plus

.mt-4
  button.btn.btn-primary((click)="testConnection()")
    i.fas.fa-plug.me-2
    | Test Connection
  span.ms-2.text-success(*ngIf="testResult === 'success'") Connected!
  span.ms-2.text-danger(*ngIf="testResult === 'error'") {{ testError }}
